    "said": { "ko": "`git add -A`·`git add .` 는 막고, 파일 이름을 적은 `git add` 는 통과시켰어요", "en": "Blocked `git add -A` and `git add .` and let `git add` with a file name through" },
    "block": [{ "tool_name": "Bash", "tool_input": { "command": "git add -A" } }, { "tool_name": "Bash", "tool_input": { "command": "git add ." } }],
    "pass": [{ "tool_name": "Bash", "tool_input": { "command": "git add src/app.js" } }]
  },
