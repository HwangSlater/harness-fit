    "block": [{ "tool_name": "Write", "tool_input": { "file_path": "<probe>/.github/workflows/triage.yml", "content": "on: issues\njobs:\n  triage:\n    runs-on: ubuntu-latest\n    steps:\n      - run: echo \"${{ github.event.issue.title }}\"\n" } }],
    "pass": [{ "tool_name": "Write", "tool_input": { "file_path": "<probe>/.github/workflows/triage.yml", "content": "on: issues\njobs:\n  triage:\n    runs-on: ubuntu-latest\n    steps:\n      - env:\n          TITLE: ${{ github.event.issue.title }}\n        run: echo \"$TITLE\"\n" } }]
