{
  "_설명": "추천 조합. 조합은 '어떻게 일하나'로 나누고, 스택별 스킬과 언어별 훅(hooks)은 stackAddons 로 감지 결과에 따라 자동으로 더한다(조합 수를 늘리지 않으려고).",
  "codeOnly": {"_설명": "앱 코드가 있어야 쓸모 있는 스킬 — 인프라 코드만 있는 저장소(detect code: false)면 기본에서 뺀다(역할극 15 회차, 2026-11-12)", "skills": ["tdd-lite", "test-driven-development"]},
  "remoteSay": {"_설명": "원격·운영 명령 묻기(ask-cmd remote)의 이유 줄에 감지된 스택의 명령을 적는다 — 「ssh 등 원격 명령」으로만 적어 terraform·kubectl·helm 이 이미 묻기 대상인 줄 몰랐다(역할극 15 회차, 2026-11-13). try 는 실제로 묻는지 시험이 hooks/lib/remote-cmd.mjs 로 확인한다", "stacks": [{"stack": "Terraform", "say": "terraform apply·destroy", "try": ["terraform apply", "terraform destroy"]}, {"stack": "Kubernetes", "say": "kubectl delete·drain", "try": ["kubectl delete pod x", "kubectl drain node-1"]}, {"stack": "Helm", "say": "helm upgrade", "try": ["helm upgrade api charts/api"]}, {"stack": "Argo CD", "say": "argocd app sync", "try": ["argocd app sync api-prod"]}, {"stack": "Ansible", "say": "ansible-playbook", "try": ["ansible-playbook site.yml"]}, {"stack": "PostgreSQL", "say": "psql -h <host>", "try": ["psql -h db.example.com"]}, {"stack": "Kafka", "say": "kafka-topics --delete", "try": ["kafka-topics --delete --topic t"]}], "always": {"say": "ssh", "try": ["ssh host"]}, "max": 4},
  "flowSkills": {"_설명": "PR 로 합치는 브랜치 방식이면 저장소 일하는 방식에 맞춘 스킬 — 스킬 목록 줄이기(picker/budget.js)에서 스택 맞춤과 함께 맨 나중에 뺀다. PR 팀에서 pr-writer 가 먼저 빠지던 일(역할극 16 회차, 2026-11-13)", "flows": ["github-flow", "git-flow"], "skills": ["pr-writer"]},
  "githubOnly": {"_설명": "GitHub 에서만 쓰는 것 — GitLab 저장소면 기본에서 뺀다(역할극 14 회차, 2026-11-12)", "hooks": ["prefer-gh", "pr-merge"], "skills": ["pr-writer"]},
