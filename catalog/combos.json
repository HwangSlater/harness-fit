{
  "_설명": "추천 조합. 조합은 '어떻게 일하나'로 나누고, 스택별 스킬과 언어별 훅(hooks)은 stackAddons 로 감지 결과에 따라 자동으로 더한다(조합 수를 늘리지 않으려고).",
  "combos": [
    {
      "id": "light",
      "name": {
        "ko": "가볍게",
        "en": "Light"
      },
      "desc": {
        "ko": "안전장치 훅만. 문맥에 거의 안 들어가요",
        "en": "Safety hooks only. Almost no context cost"
      },
      "skills": [],
      "hooks": [
        "secrets",
        "protected-files",
        "danger-cmd",
        "password-cli"
      ],
      "rules": [
        "commands",
        "lean"
      ],
      "flow": "none",
      "stackAddons": false,
      "for": {
        "ko": "이것저것 넣기 싫고, 실수만 막고 싶을 때",
        "en": "You just want mistakes blocked, nothing else"
      }
    },
    {
      "id": "solo",
      "name": {
        "ko": "혼자 빠르게",
        "en": "Solo"
      },
      "desc": {
        "ko": "가벼운 계획·디버깅·검증 + 스택 맞춤",
        "en": "Light planning, debugging, verification + stack picks"
      },
      "skills": [
        "grilling",
        "systematic-debugging",
        "tdd-lite",
        "verification-before-completion",
        "handoff"
      ],
      "hooks": [
        "secrets",
        "protected-files",
        "danger-cmd",
        "password-cli",
        "unsafe-html",
        "gha-inject",
        "prefer-gh"
      ],
      "rules": [
        "commands",
        "lean",
        "security",
        "structure"
      ],
      "flow": "none",
      "stackAddons": true,
      "for": {
        "ko": "혼자 개발하면서 Claude를 꾸준히 쓸 때",
        "en": "You build alone and use Claude daily"
      }
    },
    {
      "id": "team",
      "share": true,
      "name": {
        "ko": "팀 협업",
        "en": "Team"
      },
      "desc": {
        "ko": "PR·리뷰·브랜치 전략까지",
        "en": "Adds PR, review and a branch strategy"
      },
      "skills": [
        "brainstorming",
        "writing-plans",
        "systematic-debugging",
        "tdd-lite",
        "verification-before-completion",
        "receiving-code-review",
        "pr-writer",
        "finishing-a-development-branch"
      ],
      "hooks": [
        "secrets",
        "protected-files",
        "danger-cmd",
        "password-cli",
        "git-add-all",
        "protect-branch",
        "commit-msg",
        "branch-name",
        "no-verify",
        "unsafe-html",
        "no-rewrite-pushed",
        "gha-inject",
        "prefer-gh"
      ],
      "rules": [
        "commands",
        "lean",
        "security",
        "structure",
        "collab"
      ],
      "flow": "github-flow",
      "stackAddons": true,
      "for": {
        "ko": "여러 명이 PR로 코드를 병합할 때",
        "en": "Several people merge code through PRs"
      }
    },
    {
      "id": "strict",
      "share": true,
      "name": {
        "ko": "꼼꼼하게",
        "en": "Thorough"
      },
      "desc": {
        "ko": "팀 협업 + 보안 리뷰·의존성 점검",
        "en": "Team + security review and dependency audit"
      },
      "skills": [
        "brainstorming",
        "writing-plans",
        "systematic-debugging",
        "test-driven-development",
        "verification-before-completion",
        "receiving-code-review",
        "pr-writer",
        "finishing-a-development-branch",
        "find-bugs",
        "supply-chain-risk-auditor",
        "skill-scanner"
      ],
      "hooks": [
        "secrets",
        "protected-files",
        "danger-cmd",
        "password-cli",
        "git-add-all",
        "protect-branch",
        "commit-msg",
        "branch-name",
        "no-verify",
        "file-size",
        "unsafe-html",
        "pin-deps",
        "no-rewrite-pushed",
        "gha-inject",
        "prefer-gh"
      ],
      "rules": [
        "commands",
        "lean",
        "security",
        "structure",
        "collab"
      ],
      "flow": "github-flow",
      "stackAddons": true,
      "for": {
        "ko": "보안·품질 점검까지 챙겨야 할 때",
        "en": "You also need security and quality checks"
      }
    }
  ],
  "stackAddons": [
    {
      "when": [
        "React",
        "Next.js"
      ],
      "skills": [
        "react-best-practices"
      ]
    },
    {
      "when": [
        "React",
        "Next.js",
        "Vue",
        "Svelte",
        "Angular"
      ],
      "skills": [
        "frontend-ui-engineering"
      ]
    },
    {
      "when": [
        "iOS"
      ],
      "skills": [
        "swiftui-pro"
      ],
      "hooks": [
        "swift-unsafe"
      ]
    },
    {
      "when": [
        "Expo"
      ],
      "skills": [
        "expo-router"
      ]
    },
    {
      "when": [
        "React Native"
      ],
      "skills": [
        "react-native-best-practices"
      ]
    },
    {
      "when": [
        "Python"
      ],
      "skills": [
        "modern-python"
      ],
      "hooks": [
        "python-unsafe"
      ]
    },
    {
      "when": [
        "Supabase"
      ],
      "skills": [
        "supabase-postgres"
      ]
    },
    {
      "when": [
        "GitHub Actions"
      ],
      "skills": [
        "gha-security-review"
      ]
    },
    {
      "when": [
        "TypeScript"
      ],
      "skills": [
        "setup-pre-commit"
      ],
      "onlyIf": [
        "team",
        "strict"
      ],
      "unless": [
        "Python"
      ]
    }
  ],
  "recommend": [
    {
      "if": "authors>1",
      "combo": "team",
      "why": {
        "ko": "최근 6개월 커밋한 사람 {authors}명",
        "en": "{authors} committers in 6 months"
      }
    },
    {
      "if": "default",
      "combo": "solo",
      "why": {
        "ko": "혼자 쓰는 저장소",
        "en": "Single-author repository"
      }
    }
  ]
}
