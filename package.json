{
  "name": "harness-fit",
  "version": "0.2.0",
  "description": "Find the skills, hooks and rules your project actually needs — a visual picker for Claude Code.",
  "type": "module",
  "bin": {
    "harness-fit": "bin/harness-fit.js"
  },
  "files": [
    "bin",
    "scripts",
    "hooks",
    "picker",
    "catalog",
    "rules",
    "config",
    "skills",
    ".claude-plugin",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/harness-fit.js",
    "test": "node --test hooks/test/*.test.mjs scripts/test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HwangSlater/harness-fit.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "skills",
    "hooks",
    "agent-skills",
    "git-flow",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "HwangSlater (https://github.com/HwangSlater)",
  "homepage": "https://github.com/HwangSlater/harness-fit#readme",
  "bugs": {
    "url": "https://github.com/HwangSlater/harness-fit/issues"
  }
}
