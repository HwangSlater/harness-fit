{
  "name": "find-your-skill",
  "version": "0.1.0",
  "description": "Find the skills, hooks and rules your project actually needs — a visual picker for Claude Code.",
  "type": "module",
  "bin": {
    "find-your-skill": "bin/find-your-skill.js"
  },
  "files": [
    "bin",
    "scripts",
    "hooks",
    "picker",
    "catalog",
    "rules",
    "config",
    "skills",
    ".claude-plugin",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/find-your-skill.js",
    "test": "node --test hooks/test/*.test.mjs scripts/test/*.test.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HwangSlater/find-your-skill.git"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "skills",
    "hooks",
    "agent-skills",
    "git-flow",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "HwangSlater (https://github.com/HwangSlater)",
  "homepage": "https://github.com/HwangSlater/find-your-skill#readme",
  "bugs": {
    "url": "https://github.com/HwangSlater/find-your-skill/issues"
  }
}
